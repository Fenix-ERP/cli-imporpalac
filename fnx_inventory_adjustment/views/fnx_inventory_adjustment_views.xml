<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- (Form View) -->
    <record id="view_fnx_inventory_adjustment_form" model="ir.ui.view">
        <field name="name">fnx.inventory.adjustment.form</field>
        <field name="model">fnx.inventory.adjustment</field>
        <field name="arch" type="xml">
            <form string="Fenix Inventory Adjustment">
                <header>
                    <button
                        name="action_confirm"
                        string="Confirm"
                        type="object"
                        invisible="state != 'draft'"
                        class="btn-primary"
                    />
                    <button
                        name="action_process"
                        string="Process"
                        type="object"
                        invisible="state != 'confirmed'"
                        class="btn-primary"
                    />
                    <button
                        name="export_template"
                        string="Export Template"
                        type="object"
                    />
                    <button
                        name="import_template"
                        string="Import Template"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,confirmed,done"
                    />
                </header>
                <sheet>
                    <div name="button_box">
                        <button
                            class="oe_stat_button"
                            type="object"
                            icon="fa-folder"
                            name="action_open_pickings"
                        >
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Open Pickings</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field
                                name="date"
                                readonly="state in ['done', 'confirmed']"
                            />
                            <field
                                name="adjustment_type"
                                readonly="state in ['done', 'confirmed']"
                            />
                            <field
                                name="origin_location_id"
                                domain='[("usage","in",["internal",],)]'
                                readonly="state in ['done', 'confirmed']"
                            />
                            <field
                                name="account_id"
                                domain="[('account_type','not in',['view'])]"
                                required="adjustment_type == 'cost'"
                                invisible="adjustment_type != 'cost'"
                                readonly="state in ['done', 'confirmed']"
                            />
                        </group>
                        <group>
                            <field
                                name="excel_file"
                                filename="excel_filename"
                                readonly="state in ['done', 'confirmed']"
                            />
                            <field name="excel_filename" invisible="1" />
                            <field
                                name="reason_id"
                                readonly="state in ['done', 'confirmed']"
                            />
                            <field
                                name="notes"
                                readonly="state in ['done', 'confirmed']"
                            />
                            <field
                                name="user_id"
                                readonly="state in ['done', 'confirmed']"
                            />
                        </group>
                    </group>
                    <group>
                        <field
                            name="terms_and_conditions"
                            readonly="state in ['done', 'confirmed']"
                        />
                    </group>
                    <notebook>
                        <page name="Adjustment Lines">

                            <field name="line_ids">
                                <tree editable="bottom" create="1" edit="1" delete="0">
                                    <field
                                        name="product_id"
                                        readonly="parent_state in ['done', 'confirmed']"
                                    />
                                    <field name="currency_id" column_invisible="True" />
                                    <field
                                        name="parent_state"
                                        column_invisible="True"
                                    />
                                    <field
                                        name="system_qty"
                                        column_invisible="parent.adjustment_type not in ('qty', 'cost_qty')"
                                    />
                                    <field
                                        name="new_qty"
                                        column_invisible="parent.adjustment_type not in ('qty', 'cost_qty')"
                                        readonly="parent_state in ['done', 'confirmed']"
                                    />
                                    <field
                                        name="product_uom_id"
                                        column_invisible="parent.adjustment_type not in ('qty', 'cost_qty')"
                                    />
                                    <field
                                        name="system_cost"
                                        column_invisible="parent.adjustment_type not in ('cost', 'cost_qty')"
                                    />
                                    <field
                                        name="real_cost"
                                        column_invisible="parent.adjustment_type not in ('cost', 'cost_qty')"
                                        readonly="parent_state in ['done', 'confirmed']"
                                    />
                                    <field
                                        name="account_move_ids"
                                        optional="hide"
                                        widget="many2many_tags"
                                    />


                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- (Tree View) -->
    <record id="view_fnx_inventory_adjustment_tree" model="ir.ui.view">
        <field name="name">fnx.inventory.adjustment.tree</field>
        <field name="model">fnx.inventory.adjustment</field>
        <field name="arch" type="xml">
            <tree string="Fnx Inventory Adjustment">
                <field name="name" />
                <field name="date" />
                <field name="reason_id" />
                <field name="user_id" />
            </tree>
        </field>
    </record>


    <!-- (Window Action) -->
    <record id="action_fnx_inventory_adjustment" model="ir.actions.act_window">
        <field name="name">Fenix Inventory Adjustment</field>
        <field name="res_model">fnx.inventory.adjustment</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menú -->
    <menuitem
        id="menu_fnx_inventory_adjustment"
        sequence="10"
        name="Fenix Inventory Adjustment"
        parent="stock.menu_stock_adjustments"
        action="fnx_inventory_adjustment.action_fnx_inventory_adjustment"
    />
</odoo>
