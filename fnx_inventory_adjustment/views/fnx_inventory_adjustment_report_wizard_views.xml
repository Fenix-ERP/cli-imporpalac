<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_fnx_inventory_adjustment_report_wizard_form" model="ir.ui.view">
        <field name="name">fnx.inventory.adjustment.report.wizard.form</field>
        <field name="model">fnx.inventory.adjustment.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Inventory Adjustment Report">
                <group>
                    <field name="date_from" />
                    <field name="date_to" />
                </group>
                <footer>
                    <button
                        name="action_export_xlsx"
                        string="Export Excel"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record
        id="action_fnx_inventory_adjustment_report_wizard"
        model="ir.actions.act_window"
    >
        <field name="name">Inventory Adjustment Report</field>
        <field name="res_model">fnx.inventory.adjustment.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_fnx_inventory_adjustment_report"
        name="Inventory Adjustment Report"
        parent="stock.menu_stock_adjustments"
        action="fnx_inventory_adjustment.action_fnx_inventory_adjustment_report_wizard"
        sequence="20"
    />
</odoo>
