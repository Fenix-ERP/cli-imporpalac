<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- (Form View) -->
    <record id="view_fnx_adjustment_reason_form" model="ir.ui.view">
        <field name="name">fnx.adjustment.reason.form</field>
        <field name="model">fnx.adjustment.reason</field>
        <field name="arch" type="xml">
            <form string="Fenix Adjustment Reason">
                <header>

                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- (Tree View) -->
    <record id="view_fnx_adjustment_reason_tree" model="ir.ui.view">
        <field name="name">fnx.adjustment.reason.tree</field>
        <field name="model">fnx.adjustment.reason</field>
        <field name="arch" type="xml">
            <tree string="Fnx Inventory Adjustment">
                <field name="name" />
            </tree>
        </field>
    </record>


    <!-- (Window Action) -->
    <record id="action_fnx_adjustment_reason" model="ir.actions.act_window">
        <field name="name">Fenix Adjustment Reason</field>
        <field name="res_model">fnx.adjustment.reason</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menú -->
    <menuitem
        id="menu_fnx_adjustment_reason"
        sequence="10"
        name="Fenix Adjustment Reason"
        parent="stock.menu_stock_config_settings"
        action="fnx_inventory_adjustment.action_fnx_adjustment_reason"
    />
</odoo>
